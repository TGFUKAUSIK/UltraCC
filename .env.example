# UltraCC web app configuration.
#
# Copy this file to `.env.local` and fill in your own values. Every VITE_ value
# is compiled into the public browser bundle, so never put a secret here — only
# the Supabase anon (publishable) key belongs in this file.
#
# Nothing here is required to see the app run: with the placeholders left as
# they are, the app starts in offline/demo mode and the backend screens say they
# are not configured. See "Backend setup" in README.md.

# Your Supabase project URL and anon key. Both are public by design; row-level
# security on the tables is what protects the data.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Edge functions this app talks to. Keep the paths if you deploy the bundled
# functions unchanged.
VITE_VTOP_GATEWAY_URL="https://your-project.supabase.co/functions/v1/vtop-gateway"
VITE_LMS_GATEWAY_URL="https://your-project.supabase.co/functions/v1/lms-gateway"

# The AI Advisor has no server-side key: the browser calls Gemini directly with
# the key the student saved in Settings, held in this browser only. Never add a
# VITE_ fallback for an operator key — every VITE_ value is compiled into the
# public bundle.

# --- Background notifications (Web Push) -------------------------------------
# Optional. Generate a pair with `npm run vapid`, put the public half here and
# the private half in the push-dispatch function's secrets. Leave both unset and
# notifications stay in-app only.
# VITE_VAPID_PUBLIC_KEY=""

# Edge-function secrets (set with `supabase secrets set`, NEVER in this file):
#   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# The dispatcher's own secret needs no configuration: it is generated inside
# the database (public.push_cron_config) and verified over an RPC. Setting
# CRON_SECRET overrides that with a plain shared secret.
