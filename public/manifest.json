    },
    {
      "name": "Attendance",
      "short_name": "Attendance",
      "url": "/?tab=academics&source=pwa",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Free Classrooms & Labs",
      "short_name": "Free Rooms",
      "url": "/?tab=freeClassrooms&source=pwa",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Exam Schedule",
      "short_name": "Exams",
      "url": "/?tab=exams&source=pwa",
      "icons": [{ "src": "/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
