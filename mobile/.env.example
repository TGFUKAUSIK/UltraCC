# UltraCC mobile app configuration.
#
# Expo inlines every EXPO_PUBLIC_ value into the app bundle, so never put a
# secret here — only the Supabase anon (publishable) key.
#
# Copy this file to `mobile/.env.local` before `npx expo start` (or set the same
# two variables in your EAS build profile). With the placeholders left as they
# are, the app builds but its backend screens stay empty.

EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
